# ---------------------------------------------------------------------------
# Plaid
# ---------------------------------------------------------------------------
# Both Sandbox and Production credentials live here so switching environments
# is a one-line change. PLAID_ENV selects which pair is used at runtime.
#
# Get Sandbox keys:  https://dashboard.plaid.com/developers/keys
# Get Production keys: https://dashboard.plaid.com/developers/keys
#
# WARNING (PLANNED_ARCHITECTURE.md section 2): the Production Trial plan is
# capped at 10 Items, and /item/remove does NOT free a slot. Develop against
# Sandbox. Only set PLAID_ENV=production once Phase 5 is ready.
PLAID_ENV=sandbox

PLAID_SANDBOX_CLIENT_ID=
PLAID_SANDBOX_SECRET=
PLAID_PRODUCTION_CLIENT_ID=
PLAID_PRODUCTION_SECRET=

# HTTPS URL Plaid posts webhooks to. Use a tunnel (cloudflared / ngrok) in
# local dev, or your Vercel production URL. Must be HTTPS for real banks.
PLAID_WEBHOOK_URL=

# Required for OAuth institutions (Chase, BofA, Amex, ...). Must be HTTPS and
# registered in the Plaid Dashboard under Developer -> OAuth.
PLAID_REDIRECT_URI=

# How many days of transaction history to pull on the FIRST sync of an Item.
# This is only applied when an Item is first initialized, and cannot be
# changed afterwards. 180 is the minimum Plaid wants for Recurring
# Transactions detection; 730 gives two years of net-worth trend data.
PLAID_DAYS_REQUESTED=730

# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string.
#
# Use the plain "URI" / Session pooler connection, NOT the "Transaction pooler"
# one: Drizzle needs prepared statements and session semantics. Keep the
# password URL-encoded.
#
# Host:  db.<project-ref>.supabase.co:5432
#   or:  aws-0-<region>.pooler.supabase.com:5432  (Session mode)
# Use the TRANSACTION pooler on port 6543, not the SESSION pooler on 5432.
#
# The session pooler multiplexes onto a fixed set of backend connections shared
# by everything on the project, capped at 15 for this plan. A Next.js server
# opens more than one pool (the app and SSR bundles each get their own), so the
# session pooler exhausts with "max clients reached in session mode" and every
# page starts failing. The transaction pooler has no such cap.
#
# `?pgbouncer=true` makes the driver avoid features pgbouncer cannot support.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Supabase Auth
# ---------------------------------------------------------------------------
# Supabase -> Project Settings -> API. The anon key is designed to ship to the
# browser; it only grants what RLS allows, and this app never queries data
# through Supabase's API, only through DATABASE_URL above.
#
# There is deliberately no service-role key. Auth here needs nothing beyond the
# anon key, and a second always-valid bypass of auth is one more secret to leak.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# 32 random bytes, base64 encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ROTATING THIS INVALIDATES EVERY STORED PLAID ACCESS TOKEN, which means
# losing every linked Item AND its Trial slot. Back it up.
TOKEN_ENCRYPTION_KEY=

# Comma-separated list of emails allowed to sign in. Everyone else is refused.
# This is what stops strangers from eating your 10-Item cap.
ALLOWED_EMAILS=

# Shared secret for GET /api/cron/snapshot so nobody else can write snapshots.
CRON_SECRET=